# Copie para .env (local) ou configure no painel do Render.

# Obrigatória em produção. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Opcional. Sem ela, o app usa SQLite local em instance/.
# Supabase > Project Settings > Database > Connection string > Session pooler
DATABASE_URL=

# Opcional. Sem elas, as imagens ficam em instance/uploads.
# Supabase > Project Settings > API > Project URL e service_role key
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=studyvault
